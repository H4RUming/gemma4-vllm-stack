# gemma4-vllm-stack — example environment file.
# Copy to configs/.env (gitignored) and edit for the deployment host.

# --- Paths -------------------------------------------------------------------

# Working directory for the entire stack (logs, venvs, hf-cache, wrapper scripts).
LLM_OPS_DIR=/home/haru/Desktop/LLM-OPS

# Hugging Face cache. Share between .venv (serving) and .venv-proxy.
HF_HOME=/home/haru/Desktop/LLM-OPS/hf-cache

# Optional: HF token for gated / private models. Uncomment if needed.
# HF_TOKEN=hf_...

# --- Models ------------------------------------------------------------------

MODEL_NAME=BCCard/gemma-4-31B-it-FP8-Dynamic
ASSISTANT_MODEL=google/gemma-4-31B-it-assistant
# Stable name exposed to clients. Hold constant across model migrations.
SERVED_NAME=gemma-4-31b-it

# --- Networking --------------------------------------------------------------

# vLLM upstream — loopback only.
VLLM_HOST=127.0.0.1
VLLM_PORT=8001

# Proxy — external surface.
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# --- vLLM serving flags ------------------------------------------------------

MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
NUM_SPECULATIVE_TOKENS=5

# --- CUDA / build ------------------------------------------------------------

CUDA_HOME=/usr/local/cuda-12.9
TORCH_CUDA_ARCH_LIST=12.0
CUDA_ARCHITECTURES=120
